# Seoul RAIM (EN) — 환경변수 예시 파일. 복사해서 .env로 사용하세요:
#   cp .env.example .env

# 서버가 리슨할 포트 (기본값 4310)
PORT=4310

# 세션 쿠키 서명용 비밀키. production에서는 필수 — 없으면 부팅이 거부됩니다.
# 아래 명령으로 랜덤 값을 생성해 채워 넣으세요:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# 실행 환경. production으로 두면 세션 쿠키에 secure 플래그가 붙고
# SESSION_SECRET 미설정 시 부팅을 거부합니다.
NODE_ENV=production

# nginx 등 리버스 프록시 뒤에서 실행할 때 1로 설정 (X-Forwarded-For 신뢰,
# 쿠키 secure 판정에 필요). 프록시 없이 직접 노출한다면 비워두세요.
TRUST_PROXY=1

# 직원 알림 메일(신규 신청/yeyak 해제 요청 등)에 들어가는 관리자 페이지 링크의
# 기준 URL. 예: https://raim.seoulraim.com
BASE_URL=

# SMTP 서버 주소. 비워두면 이메일은 실제 발송되지 않고 Admin > Emails의
# Outbox에만 기록됩니다(개발/미설정 모드).
SMTP_HOST=

# SMTP 포트 (기본값 587)
SMTP_PORT=587

# SMTP 접속에 TLS(SMTPS)를 사용하는지 여부 (true/false, 기본값 false)
SMTP_SECURE=false

# SMTP 인증 계정 (필요 없으면 비워두세요)
SMTP_USER=

# SMTP 인증 비밀번호 (필요 없으면 비워두세요)
SMTP_PASS=

# 발신자로 표시할 이메일 주소. 비워두면 관리자 설정의 contact_email을 사용합니다.
SMTP_FROM=

# SQLite 데이터베이스(raim.db, WAL 파일)를 저장할 디렉토리 (기본값 ./data)
DATA_DIR=./data
