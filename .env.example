# Seoul RAIM (EN) — 환경변수 예시 파일. 복사해서 .env로 사용하세요:
#   cp .env.example .env

# 서버가 리슨할 포트 (기본값 4310)
PORT=4310

# 리슨할 인터페이스 (기본값 127.0.0.1 = 루프백).
# 그대로 두세요 — 앱 포트가 외부에 직접 노출되면 nginx의 TLS를 우회해
# 평문으로 관리자 세션이 탈취될 수 있습니다. Docker 이미지는 내부적으로
# 0.0.0.0을 쓰고, 노출은 호스트 포트 매핑에서 루프백으로 제한합니다.
HOST=127.0.0.1

# 세션 쿠키 서명용 비밀키. production에서는 필수 — 없으면 부팅이 거부됩니다.
# 아래 명령으로 랜덤 값을 생성해 채워 넣으세요:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# 실행 환경. production으로 두면 세션 쿠키에 secure 플래그가 붙고
# SESSION_SECRET 미설정 시 부팅을 거부합니다.
NODE_ENV=production

# nginx 등 리버스 프록시 뒤에서 실행할 때 1로 설정 (X-Forwarded-For 신뢰,
# 쿠키 secure 판정에 필요). 프록시 없이 직접 노출한다면 비워두세요.
TRUST_PROXY=1

# 공개 origin. 실제 배포에서는 필수입니다 — 직원 알림 메일의 관리자 링크와
# canonical/OG 태그에 쓰이며, 비워두면 메일 링크가 localhost를 가리켜
# 직원이 클릭할 수 없습니다. 예: https://raim.seoulraim.com
BASE_URL=

# 최초 1회 admin 계정 시드에만 사용. production에서 비워두면 랜덤 생성되어
# 부팅 로그에 1회만 출력됩니다 (그 값을 저장한 뒤 로그인해서 변경하세요).
ADMIN_INITIAL_PASSWORD=

# SMTP 서버 주소. 비워두면 이메일은 실제 발송되지 않고 Admin > Emails의
# Outbox에만 기록됩니다(개발/미설정 모드).
SMTP_HOST=

# SMTP 포트 (기본값 587)
SMTP_PORT=587

# SMTP 접속에 TLS(SMTPS)를 사용하는지 여부 (true/false, 기본값 false)
SMTP_SECURE=false

# SMTP 인증 계정 (필요 없으면 비워두세요)
SMTP_USER=

# SMTP 인증 비밀번호 (필요 없으면 비워두세요)
SMTP_PASS=

# 발신자로 표시할 이메일 주소. 비워두면 관리자 설정의 contact_email을 사용합니다.
SMTP_FROM=

# SQLite 데이터베이스(raim.db, WAL 파일)를 저장할 디렉토리 (기본값 ./data)
DATA_DIR=./data

# ── Google 시트 연동 (선택) ───────────────────────────────
# 설치 방법은 scripts/apps-script/Code.gs 파일 상단 주석 참고.
#
# ① 앱 → 시트 (미러). 신청·상태 변경을 Google 시트에 자동 반영합니다.
#    둘 다 채워야 동작하며, 비워두면 기능이 꺼집니다(예약에는 영향 없음).
#
# Apps Script 웹앱 배포 후 발급되는 URL
SHEETS_WEBHOOK_URL=

# Apps Script 스크립트 속성 SHEETS_WEBHOOK_SECRET과 반드시 동일한 값. 생성:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SHEETS_WEBHOOK_SECRET=

# ② 시트 → 앱 (상태 드롭다운). 직원이 시트에서 '승인'/'거절'을 고르면 예약 상태가
#    바뀌고 신청자에게 메일이 나갑니다. 비워두면 /api/sheet/status가 503으로 꺼집니다.
#
#    위 SHEETS_WEBHOOK_SECRET과 **다른 값**을 쓰세요. 이쪽이 새면 남의 예약을 임의로
#    승인·거절하고 방문객에게 메일까지 보낼 수 있어 피해 범위가 훨씬 큽니다.
#    Apps Script 스크립트 속성 APP_STATUS_SECRET에 같은 값을 넣고,
#    APP_STATUS_URL에는 https://<BASE_URL>/api/sheet/status 를 넣습니다.
SHEETS_INBOUND_SECRET=
