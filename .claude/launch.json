{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "raim-en-preview",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "--env-file-if-exists=.env",
        "src/app.js"
      ],
      "env": {
        "DATA_DIR": "./data/preview",
        "SHEETS_INBOUND_SECRET": "demo-inbound-secret-for-local-preview-only"
      },
      "autoPort": true,
      "port": 4310
    }
  ]
}
