<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Book a Guided Tour — Seoul Robot &amp; AI Museum</title>
  <meta name="description" content="Book a free guided exhibition tour at the Seoul Robot & AI Museum — no Korean phone number required.">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Seoul Robot & AI Museum">
  <meta property="og:title" content="Book a Guided Tour — Seoul Robot &amp; AI Museum">
  <meta property="og:description" content="Book a free guided exhibition tour at the Seoul Robot & AI Museum — no Korean phone number required.">
  <meta property="og:url" content="<%= siteOrigin %><%= canonicalPath %>">
  <meta property="og:image" content="<%= siteOrigin %>/img/hero.jpg">
  <meta name="twitter:card" content="summary_large_image">
  <link rel="canonical" href="<%= siteOrigin %><%= canonicalPath %>">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="stylesheet" href="/css/site.css">
</head>
<body>
<%- include('partials/nav') %>

<main id="main" tabindex="-1"><div class="page-head">
  <div class="wrap">
    <h1>Book a Guided Tour</h1>
    <p>Free of charge. Pick a date and session, leave your name and email, and our staff will
    confirm your seats by email — no Korean phone number required.</p>
  </div>
</div>

<div class="wrap reserve-layout">
  <form class="panel" method="POST" action="/reserve" id="reserveForm">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <% if (error) { %><div class="error-box"><%= error %></div><% } %>

    <h2><span class="stepnum">1</span> Choose a date</h2>
    <label class="field" for="date">Visit date</label>
    <input type="date" id="date" name="date" required
           min="<%= today %>" max="<%= maxDate %>" value="<%= form.date || '' %>">
    <p class="form-hint">
      You can book this month; next month opens on the <%= settings.booking_open_day %>th. The museum is closed on Mondays.</p>

    <h2 style="margin-top:26px;"><span class="stepnum">2</span> Choose a session</h2>
    <div id="sessionArea">
      <div class="day-msg" id="dayMsg">Pick a date above to see available sessions.</div>
      <div class="sessions" id="sessionList"></div>
    </div>

    <h2 style="margin-top:26px;"><span class="stepnum">3</span> Your details</h2>
    <label class="field" for="name">Full name</label>
    <input type="text" id="name" name="name" required maxlength="80" value="<%= form.name || '' %>" placeholder="e.g. Maria Gonzalez">
    <label class="field" for="email">Email address</label>
    <input type="email" id="email" name="email" required maxlength="120" value="<%= form.email || '' %>" placeholder="Your confirmation will be sent here">
    <div class="hp-field" aria-hidden="true">
      <label for="website">Website</label>
      <input type="text" id="website" name="website" tabindex="-1" autocomplete="off">
    </div>
    <div class="grid cols-2" style="gap:12px;">
      <div>
        <label class="field" for="party_size">Party size</label>
        <select id="party_size" name="party_size" required>
          <% for (let n = 1; n <= Number(settings.max_party_size || 5); n++) { %>
            <option value="<%= n %>" <%= Number(form.party_size || 2) === n ? 'selected' : '' %>><%= n %><%= n === 1 ? ' person' : ' people' %></option>
          <% } %>
        </select>
        <p class="form-hint">Groups of 20–60 book by email instead.</p>
      </div>
      <div>
        <label class="field" for="country">Country</label>
        <select id="country" name="country" required>
          <option value="" <%= form.country ? '' : 'selected' %> disabled>Select your country</option>
          <optgroup label="Frequently selected">
            <% for (const c of countries.COMMON) { %>
              <option value="<%= c %>" <%= form.country === c ? 'selected' : '' %>><%= c %></option>
            <% } %>
          </optgroup>
          <optgroup label="All countries">
            <% for (const c of countries.COUNTRIES) { %>
              <option value="<%= c %>" <%= form.country === c ? 'selected' : '' %>><%= c %></option>
            <% } %>
          </optgroup>
        </select>
      </div>
    </div>

    <div class="checkline">
      <input type="checkbox" id="agree" name="agree" required <%= form.agree ? 'checked' : '' %>>
      <label for="agree">I agree that my name and email are used to manage this reservation only,
      and I understand the <strong>no-show policy</strong>: if I can't come, I will cancel via the My Booking page —
      repeated no-shows may lead to future requests being declined.</label>
    </div>

    <button class="btn btn-primary" type="submit" style="margin-top:20px;width:100%;">Submit reservation request</button>
    <p class="form-hint" style="text-align:center;margin-top:10px;">
      You'll receive a “request received” email right away, and a confirmation email once staff verify seat availability.</p>
  </form>

  <aside>
    <div class="side-card">
      <h3>How it works</h3>
      <ol>
        <li>Submit your request (takes 1 minute).</li>
        <li>Museum staff check seat availability.</li>
        <li>You get a <strong>confirmation email</strong> with your reservation code.</li>
        <li>Show the code at the 1F desk on the day.</li>
      </ol>
      <p style="margin-top:10px;"><%= settings.reply_sla_text %></p>
    </div>
    <div class="side-card">
      <h3>English tours</h3>
      <p><% if (enTours.available) { %><%= enTours.summary %>.
      All other sessions are guided in Korean, and an <strong>English audio guide (MP3)</strong>
      will be provided so you can listen along.<% } else { %>English docent tours are not currently scheduled.
      An <strong>English audio guide (MP3)</strong> will be provided so you can listen along.<% } %></p>
    </div>
    <div class="side-card">
      <h3>Groups of 20–60</h3>
      <p>Group visits are booked by email (weekdays only, 2 months ahead):<br>
      <a href="mailto:<%= settings.contact_email %>"><%= settings.contact_email %></a></p>
    </div>
    <div class="side-card">
      <h3>No booking needed for…</h3>
      <p>Robot &amp; AI Garden, the 1F interactive stations, and RAIM PLAY. <a href="/#walkin">Learn more</a></p>
    </div>
  </aside>
</div>

</main>
<%- include('partials/foot') %>
<script>
  const preselect = <%- JSON.stringify(Number(form.slot_id) || null) %>;
  const dateInput = document.getElementById('date');
  const dayMsg = document.getElementById('dayMsg');
  const list = document.getElementById('sessionList');

  async function loadSessions() {
    list.innerHTML = '';
    const date = dateInput.value;
    if (!date) { dayMsg.style.display = 'block'; dayMsg.textContent = 'Pick a date above to see available sessions.'; return; }
    dayMsg.style.display = 'block';
    dayMsg.textContent = 'Loading sessions…';
    try {
      const res = await fetch('/api/sessions?date=' + encodeURIComponent(date));
      const data = await res.json();
      if (data.closed) {
        dayMsg.textContent = (data.reason || 'The museum is closed on this date.') + ' — please pick another day.';
        return;
      }
      if (!data.sessions.length) {
        dayMsg.textContent = 'No sessions are scheduled on this date. Please pick another day.';
        return;
      }
      dayMsg.style.display = 'none';
      // 전시별로 묶어서 보여준다. 시간순으로 섞으면 방문객이 "어느 전시를 볼지"를
      // 먼저 정하지 못하고 목록을 훑어야 한다.
      const groups = [
        { type: 'permanent', title: 'Permanent Exhibition', desc: 'The museum’s main collection.' },
        { type: 'special', title: 'Special Exhibition', desc: 'The current temporary exhibition.' },
      ];
      for (const g of groups) {
        const items = data.sessions.filter(s => s.tour_type === g.type);
        if (!items.length) continue;

        const head = document.createElement('div');
        head.className = 'session-group-head';
        head.innerHTML = '<span class="t">' + g.title + '</span>' +
          '<span class="d">' + g.desc + ' · ' + items.length + ' sessions, 40 minutes each</span>';
        list.appendChild(head);

        for (const s of items) {
          const wrap = document.createElement('label');
          wrap.className = 'session-opt';
          const unavailable = s.past || s.soldout;
          const note = s.past ? ' <em style="color:#b45309;">already started</em>'
            : s.soldout ? ' <em style="color:#d22030;">fully booked</em>' : '';
          // 한국어 해설이 기본이라 배지를 달지 않는다 — 영어 도슨트 회차만 눈에 띄게 한다.
          const badge = s.language === 'en'
            ? '<span class="badge english">ENGLISH GUIDE</span>'
            : '<span class="lang-note">Korean guide · English audio guide provided</span>';
          wrap.innerHTML =
            '<input type="radio" name="slot_id" value="' + s.id + '" required ' + (unavailable ? 'disabled' : '') + '>' +
            '<span class="box">' +
              '<span class="ord">Session ' + (s.ordinal || '') + '</span>' +
              '<span class="time">' + s.start_time + '–' + s.end_time + '</span>' +
              '<span class="lbl">' + badge + note + '</span>' +
            '</span>';
          list.appendChild(wrap);
          const input = wrap.querySelector('input');
          if (preselect && Number(input.value) === preselect && !unavailable) input.checked = true;
        }
      }
    } catch (e) {
      dayMsg.textContent = 'Could not load sessions. Please try again.';
    }
  }
  dateInput.addEventListener('change', loadSessions);
  if (dateInput.value) loadSessions();
</script>
</body>
</html>
