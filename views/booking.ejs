<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>My Booking — Seoul Robot &amp; AI Museum</title>
  <meta name="description" content="Check the status of your reservation request, or cancel if your plans change.">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Seoul Robot & AI Museum">
  <meta property="og:title" content="My Booking — Seoul Robot &amp; AI Museum">
  <meta property="og:description" content="Check the status of your reservation request, or cancel if your plans change.">
  <meta property="og:url" content="<%= siteOrigin %><%= canonicalPath %>">
  <meta property="og:image" content="<%= siteOrigin %>/img/hero.jpg">
  <meta name="twitter:card" content="summary_large_image">
  <link rel="canonical" href="<%= siteOrigin %><%= canonicalPath %>">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="stylesheet" href="/css/site.css">
</head>
<body>
<%- include('partials/nav') %>

<main id="main" tabindex="-1"><div class="page-head">
  <div class="wrap">
    <h1>My Booking</h1>
    <p>Check the status of your reservation request, or cancel if your plans change.</p>
  </div>
</div>

<div class="wrap status-card">
  <% if (isNew) { %>
    <div class="status-banner st-confirmed">Your request was submitted. A “request received” email is on its way —
    staff will review it and confirm by email.
    <% if (code) { %><br>Your reservation code is <strong><%= code %></strong> — save it to check your booking later.<% } %></div>
  <% } %>
  <% if (cancelled) { %>
    <div class="status-banner st-cancelled">Your reservation has been cancelled. Thank you for letting us know.
    <br><span style="font-weight:normal;font-size:13px;">To see the full details of the cancelled booking, enter the
    email you used below.</span></div>
  <% } %>

  <div class="panel">
    <h2 style="font-size:18px;margin:0 0 14px;">Find my booking</h2>
    <%# 조회 폼은 POST다 — GET이면 코드·이메일이 쿼리스트링으로 nginx 접근 로그와
        브라우저 방문 기록에 남는다(PIPA, src/routes/public.js 참조). %>
    <form method="POST" action="/booking">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <label class="field" for="code">Reservation code</label>
      <input type="text" id="code" name="code" placeholder="RAIM-XXXXXX" value="<%= code %>" required>
      <label class="field" for="email">Email used for the booking <span style="font-weight:normal;color:#8a93a8;">— optional</span></label>
      <input type="email" id="email" name="email" value="<%= email %>">
      <p style="font-size:13px;color:#8a93a8;margin:8px 0 0;">The code alone shows your status. Add your email to see
      the full booking or to cancel it.</p>
      <button class="btn btn-primary" type="submit" style="margin-top:16px;">Check status</button>
    </form>
    <% if (error) { %><div class="error-box" style="margin-top:16px;"><%= error %></div><% } %>
  </div>

  <%# Fall back rather than throw on a status this build doesn't know — a rollback
      to an older commit would otherwise 500 this page for every row written by a
      newer one (e.g. 'waitlisted'). %>
  <% if (reservation) { const r = reservation; const [label] = STATUS_BADGE[r.status] || [r.status]; %>
    <div class="panel" style="margin-top:16px;">
      <div class="status-banner st-<%= r.status %>">
        Status: <%= label %>
        <% if (r.status === 'pending') { %> — staff are reviewing your request; you'll get an email once it's decided.<% } %>
        <% if (r.status === 'waitlisted') { %> — the session is currently full. If seats free up, we'll email you a confirmation automatically.<% } %>
        <% if (r.status === 'confirmed') { %> — see you at the museum!<% } %>
        <%# 거절 사유는 직원이 자유롭게 적는 칸이라 개인정보가 섞일 수 있다 —
            이메일로 본인 확인이 된 보기에서만 내보낸다. %>
        <% if (r.status === 'declined' && !masked) { %><%= r.decline_reason ? ' — ' + r.decline_reason : '' %><% } %>
      </div>
      <table class="kv">
        <tr><td>Code</td><td class="code-big"><%= r.code %></td></tr>
        <tr><td>Tour</td><td>
          <%= r.tour_type === 'permanent' ? 'Permanent Exhibition Tour' : 'Special Exhibition Tour' %>
          <% if (r.language === 'en') { %><span class="badge english">ENGLISH</span><% } else { %><span class="badge korean">KOREAN</span><% } %>
        </td></tr>
        <tr><td>Date &amp; time</td><td><%= r.visit_date %>, <%= r.start_time %>–<%= r.end_time %></td></tr>
        <tr><td>Name</td><td><%= masked ? maskName(r.name) : r.name %></td></tr>
        <tr><td>Party size</td><td><%= r.party_size %></td></tr>
      </table>
      <% if (masked) { %>
        <p style="font-size:13px;color:#8a93a8;margin-top:14px;">Some details are hidden because you looked this up
        with the reservation code only. Enter the email address used for the booking above to see everything
        <% if (['pending','confirmed','waitlisted'].includes(r.status)) { %>or to cancel<% } %>.</p>
      <% } %>
      <% if (!masked && ['pending','confirmed','waitlisted'].includes(r.status)) { %>
        <form method="POST" action="/booking/cancel" style="margin-top:20px;"
              onsubmit="return confirm('<%= r.status === 'waitlisted' ? 'Leave the waitlist?' : 'Cancel this reservation?' %>');">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <input type="hidden" name="code" value="<%= r.code %>">
          <input type="hidden" name="email" value="<%= r.email %>">
          <button class="btn btn-danger" type="submit"><%= r.status === 'waitlisted' ? 'Leave the waitlist' : 'Cancel this reservation' %></button>
        </form>
      <% } %>
      <% if (r.status === 'confirmed') { %>
        <p style="font-size:13px;color:#8a93a8;margin-top:14px;">On the day, arrive 10 minutes early and show this
        code at the 1F information desk.</p>
      <% } %>
      <% if (r.status === 'declined') { %>
        <p style="margin-top:14px;"><a class="btn btn-outline" href="/reserve">Try another date or session →</a></p>
      <% } %>
    </div>
  <% } %>
</div>

</main>
<%- include('partials/foot') %>
</body>
</html>
