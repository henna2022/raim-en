<%- include('partials/top', { title: '직원', active: 'staff', staff }) %>

<h1>직원 계정</h1>
<% if (saved) { %><div class="flash ok">저장됨.</div><% } %>
<% if (error) { %><div class="flash err"><%= error %></div><% } %>

<div class="panel">
  <table>
    <tr><th>아이디</th><th>이름</th><th>권한</th><th>생성일</th><th>비밀번호 재설정</th><th></th></tr>
    <% for (const s of staffRows) { %>
      <tr>
        <td><strong><%= s.username %></strong><%= s.id === staff.id ? ' (본인)' : '' %></td>
        <td><%= s.name %></td>
        <td><span class="badge <%= s.role === 'admin' ? 'badge-attended' : 'badge-cancelled' %>"><%= s.role === 'admin' ? '관리자' : '직원' %></span></td>
        <td class="muted"><%= s.created_at.slice(0, 10) %></td>
        <td>
          <form method="POST" action="/admin/staff/<%= s.id %>/password" class="row">
            <input type="hidden" name="_csrf" value="<%= csrf %>">
            <input type="password" name="password" placeholder="새 비밀번호 (8자 이상)" minlength="8" required>
            <button class="btn sm gray" type="submit">재설정</button>
          </form>
        </td>
        <td class="right">
          <% if (s.id !== staff.id) { %>
            <form method="POST" action="/admin/staff/<%= s.id %>/delete"
                  onsubmit="return confirm('<%= s.username %> 계정을 삭제할까요?');">
              <input type="hidden" name="_csrf" value="<%= csrf %>">
              <button class="btn sm red" type="submit">삭제</button>
            </form>
          <% } %>
        </td>
      </tr>
    <% } %>
  </table>
</div>

<div class="panel">
  <h2 style="margin-top:0;">직원 계정 추가</h2>
  <form method="POST" action="/admin/staff" class="row">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <div><label class="f">아이디</label><input type="text" name="username" required pattern="[a-zA-Z0-9._-]{3,}"></div>
    <div><label class="f">이름</label><input type="text" name="name" required></div>
    <div><label class="f">비밀번호 (8자 이상)</label><input type="password" name="password" minlength="8" required></div>
    <div><label class="f">권한</label>
      <select name="role"><option value="staff">직원</option><option value="admin">관리자</option></select></div>
    <div><button class="btn" type="submit">계정 추가</button></div>
  </form>
  <p class="muted">직원은 예약, 일정, 공지, 이메일을 관리할 수 있습니다. 관리자는 추가로 직원 계정과 설정을 관리할 수 있습니다.</p>
</div>

<%- include('partials/bottom') %>
