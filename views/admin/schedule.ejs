<%- include('partials/top', { title: 'Schedule', active: 'schedule', staff }) %>
<% const WDAYS = [[2,'Tue'],[3,'Wed'],[4,'Thu'],[5,'Fri'],[6,'Sat'],[0,'Sun'],[1,'Mon']]; %>

<h1>Schedule</h1>
<% if (saved) { %><div class="flash ok">Saved.</div><% } %>
<% if (error) { %><div class="flash err"><%= error %></div><% } %>

<div class="panel">
  <h2 style="margin-top:0;">Tour sessions</h2>
  <p class="muted">These define which sessions visitors can request, per weekday. Deactivate (or delete) a session to
  hide it from the booking form. Sessions with existing reservations are deactivated instead of deleted.</p>
  <table>
    <tr><th>Label</th><th>Type</th><th>Time</th><th>Language</th><th>Days</th><th>Active</th><th></th></tr>
    <% for (const s of slots) { %>
      <tr>
        <td colspan="7" style="padding:0;border-bottom:1px solid var(--line);">
          <form method="POST" action="/admin/schedule/slots/<%= s.id %>" class="row" style="padding:9px 10px;align-items:center;">
            <input type="hidden" name="_csrf" value="<%= csrf %>">
            <input type="text" name="label" value="<%= s.label %>" style="flex:1;min-width:220px;">
            <select name="tour_type">
              <option value="permanent" <%= s.tour_type === 'permanent' ? 'selected' : '' %>>Permanent</option>
              <option value="special" <%= s.tour_type === 'special' ? 'selected' : '' %>>Special</option>
            </select>
            <input type="time" name="start_time" value="<%= s.start_time %>" required>
            <input type="time" name="end_time" value="<%= s.end_time %>" required>
            <select name="language">
              <option value="ko" <%= s.language === 'ko' ? 'selected' : '' %>>Korean</option>
              <option value="en" <%= s.language === 'en' ? 'selected' : '' %>>English</option>
            </select>
            <span style="display:flex;gap:6px;flex-wrap:wrap;">
              <% for (const [num, name] of WDAYS) { %>
                <label style="font-size:12px;display:flex;gap:3px;align-items:center;">
                  <input type="checkbox" name="weekdays" value="<%= num %>"
                         <%= s.weekdays.split(',').includes(String(num)) ? 'checked' : '' %>><%= name %>
                </label>
              <% } %>
            </span>
            <label style="font-size:12px;display:flex;gap:4px;align-items:center;">
              <input type="checkbox" name="active" <%= s.active ? 'checked' : '' %>> active
            </label>
            <button class="btn sm" type="submit">Save</button>
            <button class="btn sm red" type="submit" name="_delete" value="1"
                    onclick="return confirm('Delete this session?');">Delete</button>
          </form>
        </td>
      </tr>
    <% } %>
  </table>

  <h2>Add a session</h2>
  <form method="POST" action="/admin/schedule/slots" class="row">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <div><label class="f">Label</label><input type="text" name="label" placeholder="e.g. Permanent Exhibition Tour #7" style="min-width:260px;" required></div>
    <div><label class="f">Type</label>
      <select name="tour_type"><option value="permanent">Permanent</option><option value="special">Special</option></select></div>
    <div><label class="f">Start</label><input type="time" name="start_time" required></div>
    <div><label class="f">End</label><input type="time" name="end_time" required></div>
    <div><label class="f">Language</label>
      <select name="language"><option value="ko">Korean</option><option value="en">English</option></select></div>
    <div><label class="f">Days</label>
      <span style="display:flex;gap:6px;flex-wrap:wrap;">
        <% for (const [num, name] of WDAYS) { %>
          <label style="font-size:12px;display:flex;gap:3px;align-items:center;">
            <input type="checkbox" name="weekdays" value="<%= num %>" <%= num !== 1 ? 'checked' : '' %>><%= name %>
          </label>
        <% } %>
      </span></div>
    <div><label class="f">&nbsp;</label>
      <label style="font-size:12px;"><input type="checkbox" name="active" checked> active</label></div>
    <div><button class="btn" type="submit">Add session</button></div>
  </form>
</div>

<div class="panel">
  <h2 style="margin-top:0;">Closures &amp; special openings</h2>
  <p class="muted">Mondays are closed automatically. Add a date here to close the museum on another day
  (holiday closure), or to <em>open</em> a Monday (e.g. when Monday is a public holiday and the closure moves to Tuesday).</p>
  <table>
    <tr><th>Date</th><th>Kind</th><th>Reason</th><th></th></tr>
    <% for (const c of closures) { %>
      <tr>
        <td><%= c.date %></td>
        <td><span class="badge <%= c.kind === 'open' ? 'badge-confirmed' : 'badge-declined' %>"><%= c.kind.toUpperCase() %></span></td>
        <td><%= c.reason %></td>
        <td class="right">
          <form method="POST" action="/admin/schedule/closures/<%= c.id %>/delete" style="display:inline;">
            <input type="hidden" name="_csrf" value="<%= csrf %>">
            <button class="btn sm red" type="submit">Remove</button>
          </form>
        </td>
      </tr>
    <% } %>
  </table>
  <form method="POST" action="/admin/schedule/closures" class="row" style="margin-top:14px;">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <div><label class="f">Date</label><input type="date" name="date" required></div>
    <div><label class="f">Kind</label>
      <select name="kind">
        <option value="closed">Closed (extra closure)</option>
        <option value="open">Open (override Monday closure)</option>
      </select></div>
    <div style="flex:1;"><label class="f">Reason (shown to visitors)</label>
      <input type="text" name="reason" placeholder="e.g. Chuseok holiday" style="width:100%;"></div>
    <div><button class="btn" type="submit">Add</button></div>
  </form>
</div>

<div class="panel">
  <h2 style="margin-top:0;">Opening calendar — next 120 days</h2>
  <p class="muted">Computed from the rules, so you can check them at a glance:
  Mondays are closed, <strong>but a Monday that is a public holiday opens and the Tuesday closes instead</strong>.
  <strong>1 January, Seollal day and Chuseok day are always closed</strong> — the other two days of each holiday
  period stay open. The Special Exhibition's 09:30 session runs on weekends <em>and</em> public holidays.
  Anything you add under Closures below overrides all of this.</p>
  <% if (!holidayTableCovers) { %>
    <div class="flash warn">공휴일 표는 <%= holidayYears.join(', ') %>년까지만 들어 있습니다.
    그 이후 날짜는 공휴일로 인식되지 않으니(월요일 휴관 규칙만 적용) 아래 Closures에 직접 등록하거나
    <code>src/holidays.js</code>에 연도를 추가하세요.</div>
  <% } %>
  <table>
    <tr><th>Date</th><th>Public holiday</th><th>Status</th></tr>
    <% for (const c of upcomingClosures) { %>
      <tr>
        <td><%= c.date %> <span class="muted"><%= ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'][new Date(c.date + 'T12:00:00Z').getUTCDay()] %></span></td>
        <td><%= c.holiday %></td>
        <td>
          <% if (c.open) { %><span class="badge badge-confirmed">OPEN</span>
          <% } else { %><span class="badge badge-declined">CLOSED</span> <span class="muted"><%= c.reason %></span><% } %>
        </td>
      </tr>
    <% } %>
  </table>
</div>

<div class="panel">
  <h2 style="margin-top:0;">Fully booked (sold-out) sessions</h2>
  <p class="muted">A session marked here stops appearing on the booking form for that date, so visitors
  can't file requests you would only have to decline. Marks are usually set from the decline form on the
  Dashboard; add one manually when you spot a full session in yeyak. Remove the mark if seats free up —
  past dates are cleaned up automatically.</p>
  <% if (soldout.length === 0) { %><p class="muted">No upcoming sold-out sessions.</p><% } else { %>
  <table>
    <tr><th>Date</th><th>Session</th><th>Marked by</th><th></th></tr>
    <% for (const so of soldout) { %>
      <tr>
        <td><%= so.date %></td>
        <td><%= so.start_time %>–<%= so.end_time %> · <%= so.tour_type === 'permanent' ? 'Permanent' : 'Special' %>
            <span class="badge badge-<%= so.language %>"><%= so.language.toUpperCase() %></span></td>
        <td class="muted"><%= so.created_by %> · <%= so.created_at ? so.created_at.slice(0, 16) : '' %></td>
        <td class="right">
          <form method="POST" action="/admin/schedule/soldout/<%= so.id %>/delete" style="display:inline;">
            <input type="hidden" name="_csrf" value="<%= csrf %>">
            <button class="btn sm red" type="submit">Remove</button>
          </form>
        </td>
      </tr>
    <% } %>
  </table>
  <% } %>
  <form method="POST" action="/admin/schedule/soldout" class="row" style="margin-top:14px;">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <div><label class="f">Date</label><input type="date" name="date" min="<%= today %>" required></div>
    <div><label class="f">Session</label>
      <select name="slot_id">
        <% const DAY_SHORT = ['Sun','Mon','Tue','Wed','Thu','Fri','Sat']; %>
        <% for (const s of slots.filter(s => s.active)) { %>
          <option value="<%= s.id %>"><%= s.start_time %>–<%= s.end_time %> <%= s.tour_type === 'permanent' ? 'Permanent' : 'Special' %> (<%= s.language.toUpperCase() %>) · <%= s.weekdays.split(',').map(n => DAY_SHORT[Number(n)]).join('/') %></option>
        <% } %>
      </select></div>
    <div><button class="btn" type="submit">Mark fully booked</button></div>
  </form>
  <p class="form-hint muted" style="margin-top:6px;">The session must actually run on the chosen date —
  marks for wrong-weekday or closed dates are rejected.</p>
</div>

<%- include('partials/bottom') %>
