<%- include('partials/top', { title: 'Notices', active: 'notices', staff }) %>

<h1>Notices</h1>
<% if (saved) { %><div class="flash ok">Saved.</div><% } %>
<p class="muted">Published notices appear in the “Notices” section of the public English site.
Keep them visitor-relevant: closures, special openings, parking, events.</p>

<div class="panel">
  <h2 style="margin-top:0;">Add a notice</h2>
  <form method="POST" action="/admin/notices">
    <label class="f">Title</label>
    <input type="text" name="title" style="width:100%;" required maxlength="200">
    <label class="f">Body (plain text, English)</label>
    <textarea name="body" rows="3" style="width:100%;" required maxlength="2000"></textarea>
    <div class="row" style="margin-top:10px;">
      <div><label class="f">Category</label>
        <select name="category">
          <option value="general">General</option><option value="hours">Hours/Closure</option>
          <option value="parking">Parking</option><option value="event">Event</option>
        </select></div>
      <div><label class="f">&nbsp;</label><label style="font-size:13px;"><input type="checkbox" name="pinned"> 📌 pin to top</label></div>
      <div><label class="f">&nbsp;</label><label style="font-size:13px;"><input type="checkbox" name="published" checked> published</label></div>
      <div><button class="btn" type="submit">Add notice</button></div>
    </div>
  </form>
</div>

<% for (const n of notices) { %>
  <div class="panel">
    <form method="POST" action="/admin/notices/<%= n.id %>">
      <div class="row" style="align-items:center;">
        <strong style="flex:1;"><% if (n.pinned) { %>📌 <% } %><%= n.title %></strong>
        <span class="badge <%= n.published ? 'badge-confirmed' : 'badge-cancelled' %>"><%= n.published ? 'PUBLISHED' : 'HIDDEN' %></span>
        <span class="muted"><%= n.created_at.slice(0, 10) %></span>
      </div>
      <label class="f">Title</label>
      <input type="text" name="title" value="<%= n.title %>" style="width:100%;" required maxlength="200">
      <label class="f">Body</label>
      <textarea name="body" rows="3" style="width:100%;" required maxlength="2000"><%= n.body %></textarea>
      <div class="row" style="margin-top:10px;">
        <div><label class="f">Category</label>
          <select name="category">
            <% for (const c of ['general','hours','parking','event']) { %>
              <option value="<%= c %>" <%= n.category === c ? 'selected' : '' %>><%= c %></option>
            <% } %>
          </select></div>
        <div><label class="f">&nbsp;</label><label style="font-size:13px;"><input type="checkbox" name="pinned" <%= n.pinned ? 'checked' : '' %>> pinned</label></div>
        <div><label class="f">&nbsp;</label><label style="font-size:13px;"><input type="checkbox" name="published" <%= n.published ? 'checked' : '' %>> published</label></div>
        <div><button class="btn sm" type="submit">Save</button></div>
        <div><button class="btn sm red" type="submit" name="_delete" value="1"
                     onclick="return confirm('Delete this notice?');">Delete</button></div>
      </div>
    </form>
  </div>
<% } %>

<%- include('partials/bottom') %>
