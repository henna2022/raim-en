<%- include('partials/top', { title: 'Settings', active: 'settings', staff }) %>

<h1>Settings</h1>
<% if (saved) { %><div class="flash ok">Saved.</div><% } %>
<% if (error) { %><div class="flash err"><%= error %></div><% } %>

<div class="panel">
  <form method="POST" action="/admin/settings" style="max-width:640px;">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <label class="f">Contact email (shown on the site &amp; in emails)</label>
    <input type="email" name="contact_email" value="<%= settings.contact_email %>" style="width:100%;">
    <label class="f">Contact phone</label>
    <input type="text" name="contact_phone" value="<%= settings.contact_phone %>" style="width:100%;">
    <label class="f">Address (English)</label>
    <input type="text" name="address_en" value="<%= settings.address_en %>" style="width:100%;">
    <label class="f">Max party size per online request</label>
    <input type="number" name="max_party_size" value="<%= settings.max_party_size %>" min="1" max="19">
    <label class="f">Booking window (days ahead)</label>
    <input type="number" name="booking_window_days" value="<%= settings.booking_window_days %>" min="1" max="180">
    <label class="f">Reply-time text shown to visitors</label>
    <input type="text" name="reply_sla_text" value="<%= settings.reply_sla_text %>" style="width:100%;">
    <label class="f">Staff notification email (new requests &amp; yeyak releases — empty to disable)</label>
    <input type="email" name="staff_notify_email" value="<%= settings.staff_notify_email %>" style="width:100%;">
    <label class="f">Morning digest hour (KST 0–23 — daily summary of pending / SLA breaches / yeyak releases; empty to disable)</label>
    <input type="number" name="digest_hour" value="<%= settings.digest_hour %>" min="0" max="23">
    <label class="f">Personal data retention (days after visit date)</label>
    <input type="number" name="retention_days" value="<%= settings.retention_days %>" min="1" max="3650">
    <label class="f">No-show record retention (days)</label>
    <input type="number" name="noshow_retention_days" value="<%= settings.noshow_retention_days %>" min="1" max="3650">

    <h2>Yeyak helper links (dashboard)</h2>
    <p class="muted" style="margin:0 0 6px;">Shown next to each pending group. yeyak opens a fresh
    service page per month — update the two service URLs when the new month's services go up.
    Leave empty to hide a link. URLs must start with <code>https://</code>.</p>
    <label class="f">yeyak service URL — Permanent Exhibition (this month)</label>
    <input type="text" name="yeyak_url_permanent" value="<%= settings.yeyak_url_permanent %>" style="width:100%;" placeholder="https://yeyak.seoul.go.kr/web/reservation/selectReservView.do?rsv_svc_id=...">
    <label class="f">yeyak service URL — Special Exhibition (this month)</label>
    <input type="text" name="yeyak_url_special" value="<%= settings.yeyak_url_special %>" style="width:100%;" placeholder="https://yeyak.seoul.go.kr/web/reservation/selectReservView.do?rsv_svc_id=...">
    <label class="f">yeyak admin console URL (관리자시스템 — optional)</label>
    <input type="text" name="yeyak_admin_url" value="<%= settings.yeyak_admin_url %>" style="width:100%;" placeholder="https://...">

    <br><button class="btn" type="submit" style="margin-top:16px;">Save settings</button>
  </form>
</div>

<div class="panel">
  <h2 style="margin-top:0;">Email delivery</h2>
  <% if (smtpConfigured) { %>
    <p>SMTP is configured — emails are sent for real (and logged under <a href="/admin/emails">Emails</a>).</p>
  <% } else { %>
    <p>SMTP is <strong>not configured</strong>. Emails are stored in the <a href="/admin/emails">Outbox</a> for preview only.</p>
    <p class="muted">To send real mail, set these environment variables before starting the server:<br>
    <code>SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASS, SMTP_FROM</code> (see README.md).</p>
  <% } %>
</div>

<%- include('partials/bottom') %>
