<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>직원 로그인 — RAIM Admin</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body>
<div class="login-wrap">
  <div class="panel">
    <div class="brandmark" aria-hidden="true">
      <svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
        <circle cx="34" cy="42" r="9" fill="#fff"/><circle cx="66" cy="42" r="9" fill="#fff"/>
        <line x1="32" y1="68" x2="68" y2="68" stroke="#fff" stroke-width="7" stroke-linecap="round"/>
      </svg>
    </div>
    <h1>RAIM Admin</h1>
    <p class="muted" style="text-align:center;">외국인 방문자 예약 시스템 직원 로그인.</p>
    <% if (error) { %><div class="flash err"><%= error %></div><% } %>
    <form method="POST" action="/admin/login">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <label class="f" for="username">아이디</label>
      <input type="text" id="username" name="username" required autofocus>
      <label class="f" for="password">비밀번호</label>
      <input type="password" id="password" name="password" required>
      <button class="btn" type="submit">로그인</button>
    </form>
  </div>
</div>
</body>
</html>
