<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>Desk list — <%= date %></title>
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body>
<div class="wrap">
  <div class="noprint" style="margin-bottom:14px;">
    <button class="btn" onclick="window.print()">🖨 Print</button>
    <a class="btn gray" href="/admin">Back to dashboard</a>
  </div>
  <h1>Foreign visitor reservations — <%= date %></h1>
  <p class="muted">Seoul Robot &amp; AI Museum · 1F information desk check-in list</p>
  <div class="panel">
    <% if (rows.length === 0) { %><p>No confirmed reservations on this date.</p><% } else { %>
    <table>
      <tr><th>Time</th><th>Session</th><th>Code</th><th>Name</th><th>Party</th><th>Status</th><th>Checked in</th></tr>
      <% for (const r of rows) { const [label] = STATUS_BADGE[r.status]; %>
        <tr>
          <td><strong><%= r.start_time %></strong></td>
          <td><%= r.tour_type === 'permanent' ? 'Permanent' : 'Special' %> (<%= r.language.toUpperCase() %>)</td>
          <td><%= r.code %></td>
          <td><%= r.name %></td>
          <td><%= r.party_size %></td>
          <td><%= label %></td>
          <td style="width:80px;">☐</td>
        </tr>
      <% } %>
    </table>
    <% } %>
  </div>
</div>
</body>
</html>
